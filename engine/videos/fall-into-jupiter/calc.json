    },
    "terminal": {
      "title": "Terminal speed",
      "formula": "v = √(2mg / ρ C A)",
      "sub": "m = 80 kg, A = 0.7 m², ρ = 0.16 kg/m³",
      "result": "≈ 690 km/h at 1 bar",
      "note": "the thicker the air, the slower you fall",
      "src": "NASA; drag law"
    },
    "float": {
      "title": "Where you stop sinking",
      "formula": "ρ(r) = ρc · sin(kr) / kr = ρyou",
