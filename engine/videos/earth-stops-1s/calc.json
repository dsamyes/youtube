  "cards": {
    "v_equator": {
      "title": "How fast is the equator moving?",
      "formula": "v = 2πR ÷ T",
      "sub": "2π × 6,378.137 km ÷ 23 h 56 min 4 s",
      "result": "465 m/s ≈ 1,670 km/h",
      "note": "T = sidereal day (one turn relative to the stars)",
      "src": "NASA Earth Fact Sheet · WGS84"
    },
    "v_latitude": {
      "title": "Your speed depends on latitude",
      "formula": "v = ω · R · cos(latitude)",
      "sub": "London 51.5°N: 465 × cos 51.5° (WGS84)",
      "result": "≈ 290 m/s",
      "note": "Exact ellipsoid formula used in calc.py",
      "src": "WGS84"
    },
    "friction": {
      "title": "Can friction stop you?",
      "formula": "a = μ · g",
      "sub": "0.7 × 9.81 m/s² = 6.9 m/s²",
      "result": "after 1 s: still 458 m/s",
      "note": "μ ≈ 0.7: rubber on dry concrete",
      "src": "Engineering ToolBox"
    },
    "ke_person": {
      "title": "Your kinetic energy",
      "formula": "E = ½ m v²",
      "sub": "½ × 70 kg × (465 m/s)²",
      "result": "7.6 MJ ≈ 1.8 kg of TNT",
      "note": "1 kg TNT = 4.184 MJ",
      "src": "NIST SP 811"
    },
    "fall_height": {
      "title": "Same as falling from…",
      "formula": "h = v² ÷ 2g",
      "sub": "(465 m/s)² ÷ (2 × 9.81 m/s²)",
      "result": "11 km  (Everest: 8.85 km)",
      "note": "No air resistance",
      "src": "Everest: Britannica"
    },
    "steel_stress": {
      "title": "The shear wave in steel",
      "formula": "τ = ρ · c · Δv",
      "sub": "7,850 kg/m³ × 3,200 m/s × 465 m/s",
      "result": "12 GPa ≈ 80× yield",
      "note": "c = √(G/ρ); A36 shear yield = 250 MPa ÷ √3 ≈ 140 MPa",
      "src": "ASTM A36 · Eng. ToolBox"
    },
    "mach": {
      "title": "How fast is that wind?",
      "formula": "c = √(γ R T) ,  M = v ÷ c",
      "sub": "√(1.4 × 287 × 288 K) = 340 m/s",
      "result": "Mach 1.37",
      "note": "Supersonic within ±43° latitude (68% of Earth)",
      "src": "US Standard Atmosphere 1976"
    },
    "ram_pressure": {
      "title": "The push on every wall",
      "formula": "q = ½ ρ v²",
      "sub": "½ × 1.225 kg/m³ × (465 m/s)²",
      "result": "≥ 132 kPa ≈ 14 t per m²",
      "note": "Shock-corrected: ~196 kPa",
      "src": "NASA Glenn"
    },
    "hurricane_ratio": {
      "title": "vs. a Category 5 hurricane",
      "formula": "q₁ ÷ q₂ = (v₁ ÷ v₂)²",
      "sub": "(465 ÷ 70 m/s)²",
      "result": "≈ 44× the push",
      "note": "Cat 5 starts at 252 km/h",
      "src": "NOAA NHC"
    },
    "atm_ke": {
      "title": "Energy in the moving air",
      "formula": "E = ½ M ⟨v²⟩",
      "sub": "½ × 5.15×10¹⁸ kg × ⅔ × (465 m/s)²",
      "result": "≈ 3.7 × 10²³ J ≈ 600 yrs of human energy use",
      "note": "⟨v²⟩ = ⅔ v² (area average of cos²); world use ≈ 620 EJ/yr",
      "src": "Trenberth & Smith 2005 · Energy Institute"
    },
    "ocean_volume": {
      "title": "Water on the move",
      "formula": "V = v · t · depth",
      "sub": "465 m/s × 1 s × 3.7 km",
      "result": "1.7 million m³ per metre",
      "note": "≈ 690 Olympic pools per metre of coast",
      "src": "NOAA (avg depth)"
    },
    "water_hammer": {
      "title": "Water hammer",
      "formula": "Δp = ρ · c · Δv",
      "sub": "1,025 kg/m³ × 1,500 m/s × 465 m/s",
